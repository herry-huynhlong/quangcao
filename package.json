{
  "name": "qavio-ads",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @qavio/api --filter @qavio/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @qavio/api test",
    "test:e2e": "pnpm --filter @qavio/api test:e2e",
    "smoke:assets": "node scripts/smoke-next-assets.mjs",
    "db:migrate": "pnpm --filter @qavio/api db:migrate"
  }
}
