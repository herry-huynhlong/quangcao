# Copy this file to .env. Never commit real secrets.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000/api
API_PORT=4000
DATABASE_URL=postgresql://qavio_ads:change-local-password@localhost:5432/qavio_ads
POSTGRES_PASSWORD=change-local-password
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=qavio_ads_session
SESSION_TTL_DAYS=14
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key-before-any-non-local-deployment
EMAIL_FROM=QAVIO Ads <no-reply@example.invalid>
# Set EMAIL_PROVIDER=resend and RESEND_API_KEY only after an approved provider is configured.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
# Required only when operating a Super Admin account; do not set it in source control.
MFA_ENCRYPTION_KEY=
